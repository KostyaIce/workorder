{
    "version": 6,
    "cmakeMinimumRequired": {
        "major": 3,
        "minor": 16,
        "patch": 0
    },
    "configurePresets": [
        {
            "name": "default",
            "displayName": "WorkOrder C++ Desktop",
            "generator": "Ninja",
            "binaryDir": "${sourceDir}/../build/cpp",
            "cacheVariables": {
                "CMAKE_BUILD_TYPE": "Debug",
                "Type": "desktop"
            }
        },
        {
            "name": "android-arm64",
            "displayName": "WorkOrder C++ Android (arm64, mobile UI)",
            "generator": "Ninja",
            "binaryDir": "${sourceDir}/../build/cpp-android-arm64",
            "cacheVariables": {
                "CMAKE_BUILD_TYPE": "Debug",
                "CMAKE_TOOLCHAIN_FILE": "$env{HOME}/Qt/6.8.3/android_arm64_v8a/lib/cmake/Qt6/qt.toolchain.cmake",
                "QT_HOST_PATH": "$env{HOME}/Qt/6.8.3/gcc_64",
                "ANDROID_ABI": "arm64-v8a",
                "Type": "mobile"
            },
            "environment": {
                "ANDROID_SDK_ROOT": "$env{HOME}/Android/Sdk",
                "ANDROID_NDK_ROOT": "$env{HOME}/Android/Sdk/ndk/26.1.10909125"
            }
        }
    ],
    "buildPresets": [
        {
            "name": "build",
            "configurePreset": "default",
            "targets": ["WorkOrder"]
        },
        {
            "name": "run-desktop",
            "configurePreset": "default",
            "targets": ["run-desktop"]
        },
        {
            "name": "run-mobile",
            "configurePreset": "default",
            "targets": ["run-mobile"]
        },
        {
            "name": "android-apk",
            "configurePreset": "android-arm64",
            "targets": ["WorkOrder_make_apk"]
        }
    ]
}
