{
    "version": 6,
    "cmakeMinimumRequired": {
        "major": 3,
        "minor": 16,
        "patch": 0
    },
    "configurePresets": [
        {
            "name": "workorder",
            "displayName": "WorkOrder (default desktop)",
            "description": "Single build dir. Use run-desktop or run-mobile targets to launch UI mode.",
            "generator": "Ninja",
            "binaryDir": "${sourceDir}/build",
            "cacheVariables": {
                "CMAKE_BUILD_TYPE": "Debug",
                "Type": "desktop"
            }
        },
        {
            "name": "desktop",
            "displayName": "WorkOrder Desktop",
            "description": "Desktop UI with sidebar navigation.",
            "inherits": "workorder",
            "binaryDir": "${sourceDir}/build/desktop",
            "cacheVariables": {
                "Type": "desktop"
            }
        },
        {
            "name": "mobile",
            "displayName": "WorkOrder Mobile (compact)",
            "description": "Compact mobile UI with bottom navigation.",
            "inherits": "workorder",
            "binaryDir": "${sourceDir}/build/mobile",
            "cacheVariables": {
                "Type": "mobile"
            }
        }
    ],
    "buildPresets": [
        {
            "name": "build",
            "displayName": "Build",
            "configurePreset": "workorder",
            "targets": ["build"]
        },
        {
            "name": "run-desktop",
            "displayName": "Run Desktop",
            "configurePreset": "workorder",
            "targets": ["run-desktop"]
        },
        {
            "name": "run-mobile",
            "displayName": "Run Mobile (compact)",
            "configurePreset": "workorder",
            "targets": ["run-mobile"]
        },
        {
            "name": "run",
            "displayName": "Run (Type from cache)",
            "configurePreset": "workorder",
            "targets": ["run"]
        },
        {
            "name": "test",
            "displayName": "Test",
            "configurePreset": "workorder",
            "targets": ["test"]
        }
    ]
}
