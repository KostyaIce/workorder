{
    "version": 6,
    "cmakeMinimumRequired": {
        "major": 3,
        "minor": 16,
        "patch": 0
    },
    "configurePresets": [
        {
            "name": "python",
            "displayName": "WorkOrder Python",
            "description": "Python/PyQt6 IDE and run targets (run-desktop, run-mobile).",
            "generator": "Ninja",
            "binaryDir": "${sourceDir}/build/python",
            "cacheVariables": {
                "CMAKE_BUILD_TYPE": "Debug",
                "WORKORDER_CMAKE_PRESET": "python",
                "Type": "desktop"
            }
        },
        {
            "name": "python-desktop",
            "displayName": "WorkOrder Python Desktop",
            "inherits": "python",
            "binaryDir": "${sourceDir}/build/python/desktop",
            "cacheVariables": {
                "Type": "desktop"
            }
        },
        {
            "name": "python-mobile",
            "displayName": "WorkOrder Python Mobile",
            "inherits": "python",
            "binaryDir": "${sourceDir}/build/python/mobile",
            "cacheVariables": {
                "Type": "mobile"
            }
        },
        {
            "name": "cpp",
            "displayName": "WorkOrder C++",
            "description": "C++ Qt6 application (WorkOrder executable, run-desktop, run-mobile).",
            "generator": "Ninja",
            "binaryDir": "${sourceDir}/build/cpp",
            "cacheVariables": {
                "CMAKE_BUILD_TYPE": "Debug",
                "WORKORDER_CMAKE_PRESET": "cpp",
                "Type": "desktop",
                "WORKORDER_QT_LOGGING_VERBOSE": "OFF"
            }
        },
        {
            "name": "cpp-logging-verbose",
            "displayName": "WorkOrder C++ (verbose Qt logging)",
            "description": "Same as cpp, with WORKORDER_QT_LOGGING_VERBOSE=ON for client Qt/QML debugging.",
            "inherits": "cpp",
            "binaryDir": "${sourceDir}/build/cpp-logging-verbose",
            "cacheVariables": {
                "WORKORDER_QT_LOGGING_VERBOSE": "ON"
            }
        },
        {
            "name": "cpp-desktop",
            "displayName": "WorkOrder C++ Desktop",
            "inherits": "cpp",
            "binaryDir": "${sourceDir}/build/cpp/desktop",
            "cacheVariables": {
                "Type": "desktop"
            }
        },
        {
            "name": "cpp-mobile",
            "displayName": "WorkOrder C++ Mobile",
            "inherits": "cpp",
            "binaryDir": "${sourceDir}/build/cpp/mobile",
            "cacheVariables": {
                "Type": "mobile"
            }
        },
        {
            "name": "cpp-android-arm64",
            "displayName": "WorkOrder C++ Android (arm64)",
            "inherits": "cpp",
            "binaryDir": "${sourceDir}/build/cpp-android-arm64",
            "cacheVariables": {
                "CMAKE_TOOLCHAIN_FILE": "$env{HOME}/Qt/6.8.3/android_arm64_v8a/lib/cmake/Qt6/qt.toolchain.cmake",
                "QT_HOST_PATH": "$env{HOME}/Qt/6.8.3/gcc_64",
                "ANDROID_ABI": "arm64-v8a",
                "Type": "mobile",
                "WORKORDER_CMAKE_PRESET": "cpp"
            },
            "environment": {
                "ANDROID_SDK_ROOT": "$env{HOME}/Android/Sdk",
                "ANDROID_NDK_ROOT": "$env{HOME}/Android/Sdk/ndk/26.1.10909125"
            }
        }
    ],
    "buildPresets": [
        {
            "name": "python-build",
            "displayName": "Python Build",
            "configurePreset": "python",
            "targets": ["build"]
        },
        {
            "name": "python-run-desktop",
            "displayName": "Python Run Desktop",
            "configurePreset": "python",
            "targets": ["run-desktop"]
        },
        {
            "name": "python-run-mobile",
            "displayName": "Python Run Mobile",
            "configurePreset": "python",
            "targets": ["run-mobile"]
        },
        {
            "name": "python-test",
            "displayName": "Python Test",
            "configurePreset": "python",
            "targets": ["test"]
        },
        {
            "name": "cpp-build",
            "displayName": "C++ Build",
            "configurePreset": "cpp",
            "targets": ["WorkOrder"]
        },
        {
            "name": "cpp-logging-verbose-build",
            "displayName": "C++ Build (verbose Qt logging)",
            "configurePreset": "cpp-logging-verbose",
            "targets": ["WorkOrder"]
        },
        {
            "name": "cpp-run-desktop",
            "displayName": "C++ Run Desktop",
            "configurePreset": "cpp",
            "targets": ["run-desktop"]
        },
        {
            "name": "cpp-run-mobile",
            "displayName": "C++ Run Mobile",
            "configurePreset": "cpp",
            "targets": ["run-mobile"]
        },
        {
            "name": "cpp-android-apk",
            "displayName": "C++ Android APK",
            "configurePreset": "cpp-android-arm64",
            "targets": ["WorkOrder_make_apk"]
        }
    ]
}
